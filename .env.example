# Copy to .env and adjust as needed. .env itself is gitignored — never
# commit real credentials or endpoint overrides containing secrets.

# 0 = use MiniStack / local endpoints below (default for this lab).
# 1 = use real AWS. The model/audit clients read this to pick endpoints.
LAB_USE_AWS=0

# Local AWS API emulation (Bedrock/IAM/CloudWatch surfaces), started via Docker.
MINISTACK_ENDPOINT=http://localhost:4566

# Local model server that the Bedrock converse proxy talks to.
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3
